# Copy to ~/.codex/aihubmix.config.toml.
# Keep AIHUBMIX_API_KEY in your local environment or secret manager.

model_provider = "aihubmix"
model = "gpt-5.2"
model_reasoning_effort = "high"

[model_providers.aihubmix]
name = "AIHubMix"
base_url = "https://aihubmix.com/v1"
wire_api = "responses"
env_key = "AIHUBMIX_API_KEY"
